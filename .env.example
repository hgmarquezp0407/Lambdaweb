# Nombre de la tabla DynamoDB. Asigna permisos IAM de lectura y escritura a la función Lambda.
DYNAMODB_TABLE_NAME=service-errors

# Clave de partición DynamoDB de cada error.
ERROR_ID_KEY=errorId

# API HTTP del agente. Debe aceptar POST { "error": { ... } } y devolver
# JSON con { "answer": "...", "origin": "...", "mermaid": "..." }.
AGENT_API_URL=
AGENT_API_TOKEN=
AGENT_TIMEOUT_MS=20000

PORT=8080
